<?xml version="1.0" encoding="UTF-8"?>
<!--
  Проекты der-exp для Xiaomi beryllium, подключаемые в манифест DerpFest ветки der-16.2
  через <include name="snippets/der.xml"/> в default.xml. Тот же состав есть отдельным
  локальным манифестом в der-exp/android_vendor_der (manifest/beryllium.xml) — для тех, кто
  собирает на стоковом DerpFest без нашего манифеста.
-->
<manifest>
  <!-- Ядро 4.19 и деревья устройства под него (Android 16). Решение владельца, сентябрь 2026:
       Android 16 на 4.9 упирается в требования платформы к ядру (NetBpfLoad требует 5.4 для
       сетевого BPF, плюс MADV_WIPEONFORK, cpuset_v2_mode и др.), а на 4.19 сообщество beryllium
       уже держит Android 16 с бэкпортами BPF (ro.bpf.kver_override в product.prop дерева).
       Основа — форки duckyduckG (ветки lineage-23.2), в der-exp ветка der-16.2: наши правки —
       steer.config и vendor/der в beryllium, nf_tables и AmneziaWG в ядре. Прежние деревья 4.9
       (der-exp/android_device_xiaomi_beryllium и др.) остаются в der-exp для истории. -->
  <project path="device/xiaomi/beryllium"
           name="der-exp/android_device_xiaomi_beryllium_419"
           remote="github" revision="der-16.2" />
  <project path="device/xiaomi/sdm845-common"
           name="der-exp/android_device_xiaomi_sdm845-common_419"
           remote="github" revision="der-16.2" />
  <project path="kernel/xiaomi/sdm845"
           name="der-exp/android_kernel_xiaomi_sdm845_419"
           remote="github" revision="der-16.2" />

  <!-- Зависимость sdm845-common (lineage.dependencies): hardware/xiaomi, у LineageOS. -->
  <project path="hardware/xiaomi"
           name="LineageOS/android_hardware_xiaomi"
           remote="github" revision="lineage-23.2" />

  <!-- Проприетарные блобы под 4.19 — из той же линии, что деревья (не TheMuppets 22.2: те
       извлекались под ядро 4.9). -->
  <project path="vendor/xiaomi/beryllium"
           name="der-exp/android_vendor_xiaomi_beryllium_419"
           remote="github" revision="der-16.2" />
  <project path="vendor/xiaomi/sdm845-common"
           name="der-exp/android_vendor_xiaomi_sdm845-common_419"
           remote="github" revision="der-16.2" />

  <!-- С ядром 4.19 hardware/qcom-caf/common выбирает для sdm845 HAL sm8250
       (QCOM_HARDWARE_VARIANT по TARGET_KERNEL_VERSION), gralloc4 и выравнивание буферов
       msmnile; sepolicy_vndr legacy-um размечает узлы sysfs ядра 4.19; HAL sm8250 дисплея,
       медиа и аудио — с поддержкой sdm845. Всё это — форки duckyduckG, у LineageOS этого нет.
       Удаление — по пути: под именем LineageOS/android_hardware_qcom_* стоят и другие пути. -->
  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <project path="hardware/qcom-caf/common" name="der-exp/android_hardware_qcom-caf_common"
           groups="qcom" remote="github" revision="der-16.2" >
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8998/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm845/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450-6.6/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
  </project>
  <remove-project name="LineageOS/android_device_qcom_sepolicy_vndr" path="device/qcom/sepolicy_vndr/legacy-um" />
  <project path="device/qcom/sepolicy_vndr/legacy-um" name="der-exp/android_device_qcom_sepolicy_vndr"
           groups="qcom,lahaina" remote="github" revision="der-16.2" />
  <remove-project name="LineageOS/android_hardware_qcom_audio" path="hardware/qcom-caf/sm8250/audio" />
  <project path="hardware/qcom-caf/sm8250/audio" name="der-exp/android_hardware_qcom_audio"
           groups="qcom,kona" remote="github" revision="der-16.2" />
  <remove-project name="LineageOS/android_hardware_qcom_display" path="hardware/qcom-caf/sm8250/display" />
  <project path="hardware/qcom-caf/sm8250/display" name="der-exp/android_hardware_qcom_display"
           groups="qcom" remote="github" revision="der-16.2" />
  <remove-project name="LineageOS/android_hardware_qcom_media" path="hardware/qcom-caf/sm8250/media" />
  <project path="hardware/qcom-caf/sm8250/media" name="der-exp/android_hardware_qcom_media"
           groups="qcom,kona" remote="github" revision="der-16.2" />

  <!-- Userspace nftables под bionic: nft в system_ext, libnftnl и libmnl статически. -->
  <project path="external/nftables"
           name="der-exp/android_external_nftables"
           remote="github" revision="der-16.2" />
  <project path="external/libnftnl"
           name="der-exp/android_external_libnftnl"
           remote="github" revision="der-16.2" />
  <project path="external/libmnl"
           name="der-exp/android_external_libmnl"
           remote="github" revision="der-16.2" />

  <!-- Mbed TLS 3.6 LTS под расширенный движок steer (клиент VLESS/Reality). Свой путь
       external/der-mbedtls: external/mbedtls занят копией AOSP 3.5.2 без модулей Soong. -->
  <project path="external/der-mbedtls"
           name="der-exp/android_external_mbedtls"
           remote="github" revision="der-16.2" />

  <!-- Надстройка der-exp: der.mk, init-сервисы, SELinux-домен steerd. Подключается из
       device.mk устройства строкой $(call inherit-product, vendor/der/config/der.mk). -->
  <project path="vendor/der"
           name="der-exp/android_vendor_der"
           remote="github" revision="der-16.2" />

  <!-- Движок steer: ветка android репозитория движка (макрос STEER_ANDROID, режим nft для
       ядра 4.9, Android.bp в корне). Репозиторий движка — не der-exp: он общий с роутерной
       сборкой, и Android-правки идут туда же, отдельной веткой. -->
  <project path="external/steer"
           name="xyzmean/steer"
           remote="github" revision="android" />

  <!-- ContactsProvider LineageOS закреплён на 59be632 — последнем коммите ДО «Prevent SQL
       injection in SelectionBuilder» (5e14890, май 2026). Тот патч безопасности зовёт
       SQLiteTokenizer.OPTION_CHECK_BRACKETS, а константа приходит парной правкой
       frameworks/base, которой во frameworks/base DerpFest 16.2 ещё нет: с головой ветки
       lineage-23.2 сборка падает на SelectionBuilder.java. Форк DerpFest этого проекта есть
       только для ветки 17. Цена: без двух майских исправлений (SelectionBuilder и предел
       размера Note.NOTE) — снять закрепление, когда DerpFest подтянет правку фреймворка. -->
  <extend-project name="LineageOS/android_packages_providers_ContactsProvider"
                  revision="59be632a60c69882bf5f772e31b2a60ca68dc483" />

  <!-- hardware/lineage/compat — форк der-exp с переходником для блоба libwfdservice.so:
       блобы beryllium из lineage-22.2 зовут трёхаргументный
       AudioSystem::setDeviceConnectionState, а в Android 16 он четырёхаргументный; bionic
       разрешает символы при загрузке, и без переходника wfdservice не запускался бы
       (падал бы по кругу). Остальное — lineage-23.2 без изменений. -->
  <remove-project name="LineageOS/android_hardware_lineage_compat" />
  <project path="hardware/lineage/compat"
           name="der-exp/android_hardware_lineage_compat"
           remote="github" revision="der-16.2" />
</manifest>
